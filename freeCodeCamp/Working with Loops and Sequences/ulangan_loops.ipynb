      " 'sky' tidak mengandung karakter vowel.\n",
      " 'rhythm' tidak mengandung karakter vowel.\n",
      " 'orange' mengandung karakter vowel yaitu 'o'\n",
      " 'fly' tidak mengandung karakter vowel.\n"
     ]
    }
   ],
   "source": [
    "kata = [\"sky\", \"rhythm\", \"orange\", \"fly\"]\n",
    "\n",
    "for x in kata:\n",
    "    for huruf in x:\n",
    "        if huruf.lower() in \"aiueo\":\n",
    "            print(f\" '{x}' mengandung karakter vowel yaitu '{huruf}'\")\n",
    "            break\n",
    "    else:\n",
    "        print(f\" '{x}' tidak mengandung karakter vowel.\")"
   ]
  }
